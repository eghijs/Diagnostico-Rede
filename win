$diagnosticoUrl = 'https://scripts.nexuscloud.cc/Diagnostico-Rede.ps1'
$diagnosticoCliente = New-Object System.Net.WebClient

try {
    $diagnosticoBytes = $diagnosticoCliente.DownloadData(
        $diagnosticoUrl
    )

    $diagnosticoUtf8 = New-Object System.Text.UTF8Encoding(
        $false,
        $true
    )

    $diagnosticoCodigo = $diagnosticoUtf8.GetString(
        $diagnosticoBytes
    )

    $diagnosticoCodigo = $diagnosticoCodigo.TrimStart(
        [char]0xFEFF
    )

    if ([string]::IsNullOrWhiteSpace($diagnosticoCodigo)) {
        throw 'O servidor retornou um arquivo vazio.'
    }

    if ($diagnosticoCodigo -match '^\s*<(?:!DOCTYPE|html)\b') {
        throw 'O servidor retornou HTML em vez do script.'
    }

    $diagnosticoBloco = [scriptblock]::Create(
        $diagnosticoCodigo
    )
}
finally {
    $diagnosticoCliente.Dispose()
}

& $diagnosticoBloco
