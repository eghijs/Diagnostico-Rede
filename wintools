#Requires -Version 5.1

& {
    Set-StrictMode -Version Latest
    $ErrorActionPreference = 'Stop'

    if ($env:OS -ne 'Windows_NT') {
        throw 'Esta central requer Windows.'
    }

    if (
        [Threading.Thread]::CurrentThread.ApartmentState -ne
        [Threading.ApartmentState]::STA
    ) {
        throw 'Abra o Windows PowerShell em modo STA.'
    }

    $identidade = [Security.Principal.WindowsIdentity]::GetCurrent()

    try {
        $principal = New-Object Security.Principal.WindowsPrincipal(
            $identidade
        )

        if (
            $principal.IsInRole(
                [Security.Principal.WindowsBuiltInRole]::Administrator
            )
        ) {
            throw 'Abra o PowerShell como usuário comum.'
        }
    }
    finally {
        $identidade.Dispose()
    }

    $baseUrl = 'https://scripts.nexuscloud.cc/'
    $utf8Estrito = New-Object Text.UTF8Encoding($false, $true)
    $utf8ComBom = New-Object Text.UTF8Encoding($true)

    function Get-Componente {
        param(
            [Parameter(Mandatory)]
            [string]$Nome
        )

        if (
            $Nome -notmatch
            '^[A-Za-z0-9][A-Za-z0-9._-]*\.(ps1|psm1|psd1)$'
        ) {
            throw 'Nome de componente inválido.'
        }

        $url = [Uri]($baseUrl + $Nome)
        $requisicao = [Net.HttpWebRequest]::Create($url)
        $requisicao.AllowAutoRedirect = $false
        $requisicao.Timeout = 30000
        $requisicao.ReadWriteTimeout = 15000
        $requisicao.UseDefaultCredentials = $false

        $resposta = $null
        $stream = $null
        $memoria = New-Object IO.MemoryStream
        $limite = 5MB
        $relogio = [Diagnostics.Stopwatch]::StartNew()

        try {
            $resposta = $requisicao.GetResponse()

            if ([int]$resposta.StatusCode -ne 200) {
                throw 'Resposta HTTP não permitida.'
            }

            if ($resposta.ContentLength -gt $limite) {
                throw 'Componente excede o limite de tamanho.'
            }

            $stream = $resposta.GetResponseStream()
            $buffer = New-Object byte[] 8192

            while ($true) {
                if ($relogio.Elapsed.TotalSeconds -gt 60) {
                    throw 'Tempo total de download excedido.'
                }

                $quantidade = $stream.Read(
                    $buffer, 0, $buffer.Length
                )

                if ($quantidade -eq 0) {
                    break
                }

                if ($memoria.Length + $quantidade -gt $limite) {
                    throw 'Componente excede o limite de tamanho.'
                }

                $memoria.Write($buffer, 0, $quantidade)
            }

            if ($memoria.Length -eq 0) {
                throw 'Componente recebido vazio.'
            }

            # Retorna o array de bytes como um único objeto.
            return ,($memoria.ToArray())
        }
        finally {
            $relogio.Stop()

            if ($null -ne $stream) {
                $stream.Dispose()
            }

            if ($null -ne $resposta) {
                $resposta.Close()
            }

            $memoria.Dispose()
        }
    }

    function Test-Codigo {
        param(
            [Parameter(Mandatory)]
            [byte[]]$Bytes,

            [Parameter(Mandatory)]
            [string]$Nome
        )

        $texto = $utf8Estrito.GetString($Bytes).TrimStart(
            [char]0xFEFF
        )

        if ($texto -match '^\s*<(?:!DOCTYPE|html)\b') {
            throw "O site retornou HTML em vez de $Nome."
        }

        $tokens = $null
        $erros = $null

        [void][Management.Automation.Language.Parser]::ParseInput(
            $texto,
            [ref]$tokens,
            [ref]$erros
        )

        if (@($erros).Count -gt 0) {
            throw "Erro de sintaxe no componente $Nome."
        }

        return $texto
    }

    $local = [Environment]::GetFolderPath('LocalApplicationData')

    if ([string]::IsNullOrWhiteSpace($local)) {
        throw 'Pasta local do usuário indisponível.'
    }

    $pasta = Join-Path (
        Join-Path $local 'NexusCloud-Toolbox\Pacotes'
    ) ([guid]::NewGuid().ToString('N'))

    [void][IO.Directory]::CreateDirectory($pasta)

    $log = Join-Path $pasta 'Inicializacao.log'

    function Add-Log {
        param([string]$Mensagem)

        [IO.File]::AppendAllText(
            $log,
            (
                (Get-Date -Format 'yyyy-MM-dd HH:mm:ss') +
                ' ' + $Mensagem + [Environment]::NewLine
            ),
            $utf8ComBom
        )
    }

    try {
        Add-Log 'Preparação do pacote iniciada.'

        foreach ($nome in @(
            'NexusCloud-Toolbox.ps1',
            'Executor.psm1',
            'Catalogo.psd1'
        )) {
            Write-Host ('Baixando ' + $nome)

            $bytes = Get-Componente -Nome $nome
            $texto = Test-Codigo -Bytes $bytes -Nome $nome

            # Componentes da central são salvos com BOM para PS 5.1.
            [IO.File]::WriteAllText(
                (Join-Path $pasta $nome),
                $texto,
                $utf8ComBom
            )

            Add-Log ('Componente recebido, ' + $nome)
        }

        $catalogo = Import-PowerShellDataFile `
            -LiteralPath (Join-Path $pasta 'Catalogo.psd1') `
            -ErrorAction Stop

        if (-not $catalogo.ContainsKey('Ferramentas')) {
            throw 'Catálogo sem ferramentas.'
        }

        # Dependências autorizadas nesta versão do carregador.
        $permitidos = @(
            'Diagnostico-Rede.ps1',
            'BloquearHotspotWindows_v2.1.ps1'
        )

        $baixados = @{}

        foreach ($ferramenta in @($catalogo.Ferramentas)) {
            if (
                $ferramenta -isnot [hashtable] -or
                -not $ferramenta.ContainsKey('Arquivo') -or
                -not $ferramenta.ContainsKey('SHA256')
            ) {
                throw 'Entrada inválida no catálogo.'
            }

            $nome = [string]$ferramenta.Arquivo

            if ($nome -cnotin $permitidos) {
                throw "Dependência não autorizada pelo carregador, $nome."
            }

            if ($baixados.ContainsKey($nome)) {
                throw 'Arquivo duplicado no catálogo.'
            }

            $baixados[$nome] = $true

            $esperado = (
                [string]$ferramenta.SHA256
            ).Trim().ToUpperInvariant()

            if ($esperado -notmatch '^[A-F0-9]{64}$') {
                throw "SHA-256 inválido para $nome."
            }

            Write-Host ('Baixando ' + $nome)
            $bytes = Get-Componente -Nome $nome

            $sha = [Security.Cryptography.SHA256]::Create()

            try {
                $recebido = (
                    [BitConverter]::ToString(
                        $sha.ComputeHash($bytes)
                    )
                ).Replace('-', '')
            }
            finally {
                $sha.Dispose()
            }

            if ($recebido -cne $esperado) {
                throw (
                    'Hash diferente do catálogo para ' + $nome +
                    '. Revise o arquivo publicado e atualize o catálogo.'
                )
            }

            [void](Test-Codigo -Bytes $bytes -Nome $nome)

            # Preserva os bytes originais das ferramentas.
            # Alterar a codificação aqui invalidaria o hash.
            [IO.File]::WriteAllBytes(
                (Join-Path $pasta $nome),
                $bytes
            )

            Add-Log ('Ferramenta validada, ' + $nome)
        }

        Add-Log 'Pacote preparado. Abrindo a central.'
    }
    catch {
        $falha = $_

        try {
            Add-Log ('Falha, ' + $falha.Exception.Message)
        }
        catch {
            Write-Warning 'Não foi possível gravar o log.'
        }

        throw $falha
    }

    $arquivoCentral = Join-Path $pasta 'NexusCloud-Toolbox.ps1'

    Write-Host 'Abrindo NexusCloud Toolbox.'

    # Executa como arquivo, preenchendo PSScriptRoot corretamente.
    # Utiliza o PowerShell atual, sem abrir outro terminal.
    & $arquivoCentral
}
